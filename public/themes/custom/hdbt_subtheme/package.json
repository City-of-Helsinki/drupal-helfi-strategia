{
  "name": "hdbt_subtheme",
  "version": "1.2.0",
  "description": "Theme builder configuration for HDBT subtheme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-helfi-strategia",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the hdbt sandbox script."
  ],
  "scripts": {
    "dev": "../../contrib/hdbt/tools/sandbox.sh node theme-builder.mjs --watch --dev",
    "dev-with-remote-data": "ELASTIC_DEV_URL=https://helfi-etusivu-elastic-proxy.api.hel.ninja npm run dev",
    "build": "../../contrib/hdbt/tools/sandbox.sh sh -c 'npm run format:js --loglevel=silent && npm run lint --loglevel=silent && node theme-builder.mjs'",
    "postinstall": "npm --prefix ../../contrib/hdbt install --no-audit --progress=false --loglevel=silent",
    "lint:scss": "../../contrib/hdbt/tools/sandbox.sh sh -c 'postcss \"src/scss/**/*.scss\" --syntax postcss-scss --use css-declaration-sorter --replace --no-map && npm run lint:stylelint --loglevel=silent'",
    "lint:stylelint": "../../contrib/hdbt/tools/sandbox.sh stylelint \"src/scss/**/*.scss\" --config ../../contrib/hdbt/theme-builder/.stylelintrc.yaml --fix",
    "lint:js": "../../contrib/hdbt/tools/sandbox.sh biome check --write --assist-enabled=true src/js/",
    "format:js": "../../contrib/hdbt/tools/sandbox.sh biome format --write src/js/",
    "lint": "../../contrib/hdbt/tools/sandbox.sh npm-run-all --parallel lint:scss lint:js -s",
    "validate-ts": "../../contrib/hdbt/tools/sandbox.sh tsc --noEmit",
    "test": "../../contrib/hdbt/tools/sandbox.sh vitest",
    "coverage": "../../contrib/hdbt/tools/sandbox.sh vitest run --coverage"
  },
  "dependencies": {
    "@hdbt/theme-builder": "file:../../contrib/hdbt/theme-builder",
    "jotai": "file:../../contrib/hdbt/node_modules/jotai",
    "js-yaml": "^4.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss-cli": "^11.0.1",
    "react": "file:../../contrib/hdbt/node_modules/react",
    "react-dom": "file:../../contrib/hdbt/node_modules/react-dom"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "breakpoint-sass": "^3.0.0",
    "glob": "^13.0.0",
    "jsdom": "^27.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  }
}
