{
  "name": "hdbt_subtheme",
  "version": "1.2.0",
  "description": "Theme builder configuration for HDBT subtheme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-helfi-strategia",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the sandbox command."
  ],
  "scripts": {
    "preinstall": "rm -rf node_modules/@hdbt/theme-builder && npm install ../../contrib/hdbt/theme-builder --loglevel=silent",
    "dev": "sandbox node theme-builder.mjs --watch --dev",
    "dev-with-remote-data": "HDBT_ELASTIC_DEV_URL=https://helfi-etusivu-elastic-proxy.api.hel.ninja npm run dev",
    "build": "sandbox sh -c 'npm run format:js --loglevel=silent && npm run lint --loglevel=silent && node theme-builder.mjs'",
    "postinstall": "npm --prefix ../../contrib/hdbt install --no-audit --progress=false --loglevel=silent",
    "lint:scss": "sandbox stylelint \"src/scss/**/*.scss\" --config node_modules/@hdbt/theme-builder/.stylelintrc.yaml --formatter string --fix",
    "lint:js": "sandbox biome check --write --assist-enabled=true src/js/",
    "format:js": "sandbox biome format --write --no-errors-on-unmatched src/js/",
    "lint": "sandbox npm-run-all --parallel lint:scss lint:js -s",
    "validate-ts": "sandbox tsc --noEmit",
    "test": "sandbox vitest",
    "coverage": "sandbox vitest run --coverage"
  },
  "dependencies": {
    "@hdbt/theme-builder": "file:../../contrib/hdbt/theme-builder",
    "jotai": "file:../../contrib/hdbt/node_modules/jotai",
    "js-yaml": "^4.1.0",
    "npm-run-all2": "^8.0.4",
    "react": "file:../../contrib/hdbt/node_modules/react",
    "react-dom": "file:../../contrib/hdbt/node_modules/react-dom"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/browser": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "breakpoint-sass": "^3.0.0",
    "glob": "^13.0.0",
    "jsdom": "^27.0.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "esbuild": false
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  },
  "overrides": {
    "svg-sprite": {
      "glob": "^13.0.0"
    }
  }
}
